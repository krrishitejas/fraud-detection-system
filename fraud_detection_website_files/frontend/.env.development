# Development only. Vite loads this file for `npm run dev` and never for a build.
#
# In development the front end is served by Vite on 5173 and the API is a separate
# process, so it needs an absolute URL. In production the backend serves the built
# bundle itself, so the API is same-origin and the code falls back to the relative
# "/api" -- which is what makes the service work on any host or port rather than
# only on 8000.
VITE_API_URL=http://127.0.0.1:8000/api
