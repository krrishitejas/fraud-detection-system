# Only needed for `npm run dev`, and .env.development already sets it.
#
# Leave VITE_API_URL unset for a production build. The backend serves the built
# bundle from its own process, so the API is same-origin and src/services/api.ts
# falls back to the relative path "/api". Setting an absolute URL here bakes a host
# and port into the bundle and the deployed service then only works on that port.
VITE_API_URL=http://127.0.0.1:8000/api
