# Backend Environment Configuration
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME="Explainable Adaptive Fraud Detection API"
VERSION=1.0.0

# Optional explicit path override to artifact directory
# Defaults automatically to the parent directory containing the model files
# ARTIFACTS_DIR="C:/Users/Shiva/Desktop/major project/fraud_detection_website_files"

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000

# Prediction and Risk Thresholds (Configurable presentation values)
DECISION_THRESHOLD=0.50
RISK_THRESHOLD_LOW=0.20
RISK_THRESHOLD_HIGH=0.60

# Request Limits
MAX_BATCH_SIZE=1000
MAX_UPLOAD_SIZE_MB=10
MAX_CSV_ROWS=5000
