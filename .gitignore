# ---------------------------------------------------------------------------
# Node. The front end packages are 208 MB across 14,160 files and are rebuilt
# from package-lock.json with `npm install`.
# ---------------------------------------------------------------------------
node_modules/

# The front end build output. The copy the service actually serves is
# backend/app/static and that one IS committed, because without it the service
# starts with no user interface. frontend/dist is the same bundle again.
frontend/dist/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# ---------------------------------------------------------------------------
# Secrets and local configuration. The templates (.env.example) are committed.
# ---------------------------------------------------------------------------
.env
*.key
*.pem

# ---------------------------------------------------------------------------
# Editor and operating system clutter
# ---------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/

# ---------------------------------------------------------------------------
# The IEEE-CIS competition data is never committed. It is 677 MB and the
# competition licence does not allow redistribution. Download it from Kaggle.
# ---------------------------------------------------------------------------
train_transaction.csv
train_identity.csv
test_*.csv

# ---------------------------------------------------------------------------
# The decision store. The serving bundle beside it (serving_config.json and
# category_encoding.json) IS committed, because the service cannot start its
# contract endpoint without it. The SQLite file is runtime data: it is created
# on first start and belongs to whoever is running the service.
# ---------------------------------------------------------------------------
fraud_detection_website_files/serving/*.sqlite3

# Working files from the design audit tooling. Reports and screenshots are
# regenerated by the inspector and are not part of the application.
fraud_detection_website_files/.taste-skill/
